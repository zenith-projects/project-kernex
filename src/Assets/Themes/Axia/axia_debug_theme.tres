; ---- Font resources ----
[sub_resource type="FontFile" id="font_regular"]
path = "res://src/Assets/Fonts/JetBrainsMono-Regular.ttf"

[sub_resource type="FontFile" id="font_bold"]
path = "res://src/Assets/Fonts/JetBrainsMono-Bold.ttf"

[sub_resource type="FontFile" id="font_medium"]
path = "res://src/Assets/Fonts/JetBrainsMono-Medium.ttf"

; ============================================================
; Theme Resource
; ============================================================

[resource]
default_font = SubResource("font_regular")
default_font_size = 13

; ---- PanelContainer ----
PanelContainer/styles/panel = SubResource("panel_normal")

; ---- Button ----
Button/fonts/font = SubResource("font_medium")
Button/colors/font_color = Color(0.851, 0.851, 0.851, 1)
Button/colors/font_hover_color = Color(0.910, 0.753, 0.376, 1)
Button/colors/font_pressed_color = Color(0.831, 0.659, 0.294, 1)
Button/colors/font_disabled_color = Color(0.502, 0.502, 0.502, 0.5)
Button/colors/font_focus_color = Color(0.851, 0.851, 0.851, 1)
Button/font_sizes/font_size = 14
Button/styles/normal = SubResource("btn_normal")
Button/styles/hover = SubResource("btn_hover")
Button/styles/pressed = SubResource("btn_pressed")
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/focus = SubResource("btn_focus")

; ---- LineEdit ----
LineEdit/colors/font_color = Color(0.851, 0.851, 0.851, 1)
LineEdit/colors/font_placeholder_color = Color(0.502, 0.502, 0.502, 1)
LineEdit/colors/caret_color = Color(0.831, 0.659, 0.294, 1)
LineEdit/colors/selection_color = Color(0.831, 0.659, 0.294, 0.25)
LineEdit/font_sizes/font_size = 14
LineEdit/styles/normal = SubResource("le_normal")
LineEdit/styles/focus = SubResource("le_focus")
LineEdit/styles/read_only = SubResource("le_readonly")

; ---- TextEdit ----
TextEdit/colors/font_color = Color(0.851, 0.851, 0.851, 1)
TextEdit/colors/font_placeholder_color = Color(0.502, 0.502, 0.502, 1)
TextEdit/colors/caret_color = Color(0.831, 0.659, 0.294, 1)
TextEdit/colors/selection_color = Color(0.831, 0.659, 0.294, 0.25)
TextEdit/font_sizes/font_size = 14
TextEdit/styles/normal = SubResource("te_normal")
TextEdit/styles/focus = SubResource("te_focus")
TextEdit/styles/read_only = SubResource("te_readonly")

; ---- OptionButton ----
OptionButton/colors/font_color = Color(0.851, 0.851, 0.851, 1)
OptionButton/colors/font_hover_color = Color(0.910, 0.753, 0.376, 1)
OptionButton/colors/font_pressed_color = Color(0.831, 0.659, 0.294, 1)
OptionButton/colors/font_disabled_color = Color(0.502, 0.502, 0.502, 0.5)
OptionButton/colors/font_focus_color = Color(0.851, 0.851, 0.851, 1)
OptionButton/font_sizes/font_size = 14
OptionButton/styles/normal = SubResource("ob_normal")
OptionButton/styles/hover = SubResource("ob_hover")
OptionButton/styles/pressed = SubResource("ob_pressed")
OptionButton/styles/focus = SubResource("ob_focus")
OptionButton/styles/disabled = SubResource("ob_disabled")

; ---- CheckButton ----
CheckButton/colors/font_color = Color(0.851, 0.851, 0.851, 1)
CheckButton/colors/font_hover_color = Color(0.910, 0.753, 0.376, 1)
CheckButton/colors/font_pressed_color = Color(0.831, 0.659, 0.294, 1)
CheckButton/font_sizes/font_size = 14
CheckButton/styles/normal = SubResource("chk_normal")
CheckButton/styles/hover = SubResource("chk_hover")

; ---- HSlider ----
HSlider/styles/slider = SubResource("slider_track")
HSlider/styles/grabber_area = SubResource("slider_grabber_area")
HSlider/styles/grabber_area_highlight = SubResource("slider_grabber_area_hl")

; ---- HSeparator ----
HSeparator/constants/separation = 1
HSeparator/styles/separator = SubResource("sep_style")

; ---- Label ----
Label/colors/font_color = Color(0.851, 0.851, 0.851, 1)
Label/font_sizes/font_size = 14

; ---- RichTextLabel ----
RichTextLabel/colors/default_color = Color(0.502, 0.502, 0.502, 1)
RichTextLabel/font_sizes/normal_font_size = 13
RichTextLabel/styles/normal = SubResource("rtl_normal")
RichTextLabel/styles/focus = SubResource("rtl_focus")

; ---- ScrollContainer ----
ScrollContainer/styles/panel = SubResource("scroll_bg")

; ---- PopupMenu (dropdown for OptionButton) ----
PopupMenu/colors/font_color = Color(0.851, 0.851, 0.851, 1)
PopupMenu/colors/font_hover_color = Color(0.910, 0.753, 0.376, 1)
PopupMenu/font_sizes/font_size = 14
PopupMenu/styles/panel = SubResource("popup_panel")
PopupMenu/styles/hover = SubResource("popup_hover")

; ---- VScrollBar ----
VScrollBar/styles/grabber = SubResource("vsb_grabber")
VScrollBar/styles/grabber_highlight = SubResource("vsb_grabber_hl")
VScrollBar/styles/grabber_pressed = SubResource("vsb_grabber_pressed")
VScrollBar/styles/scroll = SubResource("vsb_scroll")
