[gd_resource type="Theme" format=3]

; ============================================================
; AXIA Debug Panel Theme — Dark + Golden Glassmorphism
; ============================================================
; Color palette:
;   Background:       #0F0F14  (0.059, 0.059, 0.078)
;   Glass panel:      rgba(16,16,20, 0.85) = (0.063, 0.063, 0.078, 0.85)
;   Panel border:     rgba(212,168,75, 0.25) = (0.831, 0.659, 0.294, 0.25)
;   Gold accent:      #D4A84B  (0.831, 0.659, 0.294)
;   Gold bright:      #E8C060  (0.910, 0.753, 0.376)
;   Text primary:     #D9D9D9  (0.851, 0.851, 0.851)
;   Text secondary:   #808080  (0.502, 0.502, 0.502)
;   Input bg:         #111116  (0.067, 0.067, 0.086, 0.95)
;   Input focus brd:  rgba(212,168,75, 0.6) = (0.831, 0.659, 0.294, 0.6)
;   Button bg:        #1C1C22  (0.110, 0.110, 0.133, 0.9)
;   Button hover:     #2A2A32  (0.165, 0.165, 0.196, 0.95)
;   Button pressed:   #161618  (0.086, 0.086, 0.094, 0.95)
;   Slider track:     #1A1A20  (0.102, 0.102, 0.125)
;   Separator:        rgba(212,168,75, 0.15) = (0.831, 0.659, 0.294, 0.15)
;   Selection:        rgba(212,168,75, 0.25)
; ============================================================

; ---- PanelContainer: panel (dark glass with gold border) ----
[sub_resource type="StyleBoxFlat" id="panel_normal"]
bg_color = Color(0.055, 0.055, 0.070, 0.92)
border_color = Color(0.831, 0.659, 0.294, 0.20)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_left = 10
corner_radius_bottom_right = 10
content_margin_left = 0.0
content_margin_top = 0.0
content_margin_right = 0.0
content_margin_bottom = 0.0
shadow_color = Color(0.0, 0.0, 0.0, 0.3)
shadow_size = 6
shadow_offset = Vector2(0, 2)
anti_aliasing = true

